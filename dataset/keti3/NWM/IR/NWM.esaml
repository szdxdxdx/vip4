system implementation sunSearch . SunSearchCtrlImplI
  init
    WorkMode = SBM; 
    Seq_AttD = {123,123,123}; 
    Timer_Mode = nan; 
    WorkMode_Lst = SBM; 
    Tc = 0.128; 
    qJD = {0,0,0,1}; 
    OrbI = 见备注1; 
    OrbG = 见备注1; 
    Orb = 见备注1; 
    OrbOut = 见备注2; 
    FP_WoPrecession = nan; 
    FS_UseType = nan; 
    wri_si = nan; 
    wro = nan; 
  channels
    channel1[GyroFetchData] :
        data port Controller . GyroFetchData -> gyro1 . GyroFetchData ;
    channel2[GyroPowerState] :
        data port gyro1 . GyroPowerState -> Controller . GyroPowerState ;
    channel3[deltGm] :
        data port gyro1 . deltGm -> Controller . deltGm ;
    channel4[EssFetchData] :
        data port Controller . EssFetchData -> ess1 . EssFetchData ;
    channel5[Emx] :
        data port ess1 . Emx -> Controller . Emx ;
    channel6[Emy] :
        data port ess1 . Emy -> Controller . Emy ;
    channel7[t_thr] :
        data port Controller . t_thr -> jet1 . t_thr ;
    channel8[/] :
        data port Controller . / -> obdh1 . / ;
    channel9[/] :
        data port obdh1 . / -> Controller . / ;
  components
    subsystem Controller . Controller_I Controller;
    subsystem Gyro3F . Gyro3F_I gyro1;
    subsystem ESS . ESS_I ess1;
    subsystem JET . JET_I jet1;
    subsystem ExtComputer . ExtComputer_I obdh1;
end
subsystem Gyro3F
  features
    input data port GyroFetchData;
    output data port GyroPowerState;
    output data port deltGm;
end
subsystem implementation Gyro3F . Gyro3F_I
end
subsystem ESS
  features
    input data port EssFetchData;
    output data port Emx;
    output data port Emy;
end
subsystem implementation ESS . ESS_I
end
subsystem JET
  features
    input data port t_thr;
end
subsystem implementation JET . JET_I
end
subsystem ExtComputer
  features
    input data port /;
    output data port /;
end
subsystem implementation ExtComputer . ExtComputer_I
end
