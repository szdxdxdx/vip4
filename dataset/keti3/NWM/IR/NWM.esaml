xorsplit activity split_1:
end
activity implementation split_1_I:
  properties
    DetAtt1.cond = WorkMode_Lst!=SBM;
    Set7.cond = WorkMode_Lst==SBM;
end
xorsplit activity split_2:
end
activity implementation split_2_I:
  properties
    Set9.cond = WorkMode_Lst!=WorkMode;
    Set12.cond = WorkMode_Lst==WorkMode&&F_DTOrbitEUpdate==1;
    CalEnv1.cond = WorkMode_Lst==WorkMode&&F_DTOrbitEUpdate!=1&&WorkMode_Lst!=SBM;
    CalTar1.cond = WorkMode_Lst==WorkMode&&F_DTOrbitEUpdate!=1&&WorkMode_Lst==SBM&&WorkMode_Lst==EIM;
    CalTar3.cond = WorkMode_Lst==WorkMode&&F_DTOrbitEUpdate!=1&&WorkMode_Lst==SBM&&WorkMode_Lst!=EIM&&WorkMode_Lst==NWM;
end
xorsplit activity split_3:
end
activity implementation split_3_I:
  properties
    Set12.cond = F_DTOrbitEUpdate==1;
    CalEnv1.cond = F_DTOrbitEUpdate!=1&&WorkMode_Lst!=SBM;
    CalTar1.cond = F_DTOrbitEUpdate!=1&&WorkMode_Lst==SBM&&WorkMode_Lst==EIM;
    CalTar3.cond = F_DTOrbitEUpdate!=1&&WorkMode_Lst==SBM&&WorkMode_Lst!=EIM&&WorkMode_Lst==NWM;
end
xorsplit activity split_4:
end
activity implementation split_4_I:
  properties
    CalEnv1.cond = WorkMode_Lst!=SBM;
    CalTar1.cond = WorkMode_Lst==SBM&&WorkMode_Lst==EIM;
    CalTar3.cond = WorkMode_Lst==SBM&&WorkMode_Lst!=EIM&&WorkMode_Lst==NWM;
end
xorsplit activity split_5:
end
activity implementation split_5_I:
  properties
    CalTar1.cond = WorkMode_Lst==EIM;
    CalTar3.cond = WorkMode_Lst!=EIM&&WorkMode_Lst==NWM;
end
