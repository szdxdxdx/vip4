subsystem Controller implementation Controller_I  /*控制器*/
  components
    initact activity Set1 . Set1_I Set1;
     activity Set2 . Set2_I Set2;
     activity Set3 . Set3_I Set3;
     activity Set4 . Set4_I Set4;
     activity Set5 . Set5_I Set5;
     activity Set6 . Set6_I Set6;
     activity DetAtt1 . DetAtt1_I DetAtt1;
     activity DetAtt2 . DetAtt2_I DetAtt2;
     activity DetAtt3 . DetAtt3_I DetAtt3;
     activity CalCtrl1 . CalCtrl1_I CalCtrl1;
     activity CalCtrl2 . CalCtrl2_I CalCtrl2;
     activity Set7 . Set7_I Set7;
     activity Set8 . Set8_I Set8;
     activity SwitchMode1 . SwitchMode1_I SwitchMode1;
     activity Set9 . Set9_I Set9;
     activity Set10 . Set10_I Set10;
     activity Set11 . Set11_I Set11;
     activity Set12 . Set12_I Set12;
     activity CalEnv1 . CalEnv1_I CalEnv1;
     activity CalEnv2 . CalEnv2_I CalEnv2;
     activity CalTar1 . CalTar1_I CalTar1;
     activity CalTar2 . CalTar2_I CalTar2;
     activity CalTar3 . CalTar3_I CalTar3;
     activity CalTar4 . CalTar4_I CalTar4;
  processes
    channel1[StarTime] :
        data port Set1 . StarTime -> Set2 . StarTime ;
    channel2[StarTime] :
        data port Set2 . StarTime -> SwitchMode1 . StarTime ;
    channel3[StarTime] :
        data port Set2 . StarTime -> Set12 . StarTime ;
    channel4[deltG] :
        data port DetAtt1 . deltG -> DetAtt2 . deltG ;
    channel5[F_StopCtrl] :
        data port DetAtt1 . F_StopCtrl -> CalCtrl2 . F_StopCtrl ;
    channel6[Atti_ESG] :
        data port DetAtt2 . Atti_ESG -> DetAtt3 . Atti_ESG ;
    channel7[Cbo_ESG] :
        data port DetAtt2 . Cbo_ESG -> CalCtrl1 . Cbo_ESG ;
    channel8[Atti_ESG] :
        data port DetAtt3 . Atti_ESG -> CalCtrl1 . Atti_ESG ;
    channel9[Atti_C] :
        data port CalCtrl1 . Atti_C -> CalCtrl2 . Atti_C ;
    channel10[CycleNum] :
        data port Set7 . CycleNum -> DetAtt3 . CycleNum ;
    channel11[WorkMode] :
        data port SwitchMode1 . WorkMode -> Set9 . WorkMode ;
    channel12[WorkMode] :
        data port SwitchMode1 . WorkMode -> CalTar1 . WorkMode ;
    channel13[WorkMode] :
        data port SwitchMode1 . WorkMode -> CalTar3 . WorkMode ;
    channel14[WorkMode] :
        data port SwitchMode1 . WorkMode -> CalCtrl1 . WorkMode ;
    channel15[WorkMode] :
        data port SwitchMode1 . WorkMode -> CalCtrl2 . WorkMode ;
    channel16[WorkMode] :
        data port SwitchMode1 . WorkMode -> CalEnv2 . WorkMode ;
    channel17[WorkMode] :
        data port SwitchMode1 . WorkMode -> CalTar2 . WorkMode ;
    channel18[WorkMode] :
        data port SwitchMode1 . WorkMode -> CalTar4 . WorkMode ;
    channel19[t_next] :
        data port Set12 . t_next -> CalEnv1 . t_next ;
    channel20[t_next] :
        data port Set12 . t_next -> CalEnv2 . t_next ;
    channel21[qri] :
        data port CalTar1 . qri -> CalTar3 . qri ;
    channel22[TorqRef] :
        data port CalTar2 . TorqRef -> CalTar4 . TorqRef ;
    channel23[wro] :
        data port CalTar3 . wro -> CalTar4 . wro ;
    channel24[wro] :
        data port CalTar3 . wro -> CalTar2 . wro ;
  schedule
    Set1>Set2;
    Set2>Set3;
    Set3>Set4;
    Set4>Set5;
    Set5>Set6;
    Set6>DetAtt1;
    Set6>Set7;
    DetAtt1>DetAtt2;
    DetAtt2>DetAtt3;
    DetAtt3>CalCtrl1;
    CalCtrl1>CalCtrl2;
    CalCtrl2>Set7;
    Set7>Set8;
    Set8>SwitchMode1;
    SwitchMode1>Set9;
    SwitchMode1>Set12;
    SwitchMode1>CalEnv1;
    SwitchMode1>CalTar1;
    SwitchMode1>CalTar3;
    Set9>Set10;
    Set10>Set11;
    Set11>Set12;
    Set11>CalEnv1;
    Set11>CalTar1;
    Set11>CalTar3;
    Set12>CalEnv1;
    Set12>CalTar1;
    Set12>CalTar3;
    CalEnv1>CalEnv2;
    CalEnv2>CalTar1;
    CalEnv2>CalTar3;
    CalTar1>CalTar2;
    CalTar2>CalTar3;
    CalTar3>CalTar4;
    Set6>split_1;
    split_1>DetAtt1;
    split_1>Set7;
    Set6>join_1;
    CalCtrl2>join_1;
    join_1>Set7;
    SwitchMode1>split_2;
    split_2>Set9;
    split_2>Set12;
    split_2>CalEnv1;
    split_2>CalTar1;
    split_2>CalTar3;
    Set11>split_3;
    split_3>Set12;
    split_3>CalEnv1;
    split_3>CalTar1;
    split_3>CalTar3;
    Set12>split_4;
    split_4>CalEnv1;
    split_4>CalTar1;
    split_4>CalTar3;
    SwitchMode1>join_2;
    Set11>join_2;
    join_2>Set12;
    SwitchMode1>join_3;
    Set11>join_3;
    Set12>join_3;
    join_3>CalEnv1;
    CalEnv2>split_5;
    split_5>CalTar1;
    split_5>CalTar3;
    SwitchMode1>join_4;
    Set11>join_4;
    Set12>join_4;
    CalEnv2>join_4;
    join_4>CalTar1;
    SwitchMode1>join_5;
    Set11>join_5;
    Set12>join_5;
    CalEnv2>join_5;
    CalTar2>join_5;
    join_5>CalTar3;
end
activity Set1
  features
    input data port OrbI.t0;
    output data port StarTime;
end
activity implementation Set1 . Set1_I
end
activity Set2
  features
    input data port StarTime;
    input data port Tc;
    output data port StarTime;
end
activity implementation Set2 . Set2_I
end
activity Set3
  features
    output data port tx_thrGr;
end
activity implementation Set3 . Set3_I
  operations
    "设置三轴喷气脉宽为零"
end
activity Set4
  features
    output data port ty_thrGr;
end
activity implementation Set4 . Set4_I
  operations
    "设置三轴喷气脉宽为零"
end
activity Set5
  features
    output data port tz_thrGr;
end
activity implementation Set5 . Set5_I
  operations
    "设置三轴喷气脉宽为零"
end
activity Set6
  features
    output data port t_thr;
end
activity implementation Set6 . Set6_I
  operations
    "设置12个喷管喷气脉宽为0"
end
activity DetAtt1
  features
    input data port FUsing_gyro;
    input data port deltGm;
    input data port F_NoUseGroup;
    input data port FS_AttD;
    input data port FP_ModeStopCtrl;
    input data port WorkMode;
    output data port deltG;
    output data port wbi;
    output data port F_StopCtrl;
end
activity implementation DetAtt1 . DetAtt1_I
  operations
    "陀螺姿态确定：根据公式表B1条目,通过陀螺数据计算得到三轴陀螺惯性角速度和速度增量"
end
activity DetAtt2
  features
    input data port Atti_ESG;
    input data port deltG;
    input data port woi;
    input data port Seq_AttD;
    input data port D0_ESCorr;
    input data port De_ESCorr;
    input data port WorkMode;
    output data port Atti_ESG;
    output data port dAtti_ESG;
    output data port wbo_ESG;
    output data port Cbo_ESG;
    output data port w_ESG;
end
activity implementation DetAtt2 . DetAtt2_I
  operations
    "陀螺预估对地姿态：根据公式表B2条目,根据陀螺输入，预估卫星对地姿态"
end
activity DetAtt3
  features
    input data port WorkMode;
    input data port Timer_Mode;
    input data port FS_AttD;
    input data port CycleNum;
    input data port FS;
    input data port FHV_ES;
    input data port S_Emz;
    input data port FV_ES;
    input data port FU_ES;
    input data port Em;
    input data port dtheta_ES;
    input data port Phi_ES;
    input data port theta_ES;
    input data port dPhi_ES;
    input data port Atti_ESG;
    input data port D0_ESCorr;
    input data port De_ESCorr;
    output data port Eb_i;
    output data port Eb;
    output data port phi_i;
    output data port theta_i;
    output data port FV_ES;
    output data port FU_ES;
    output data port Em;
    output data port Phi_ES;
    output data port theta_ES;
    output data port dPhi_ES;
    output data port dtheta_ES;
    output data port Atti_ESG;
    output data port D0_ESCorr;
    output data port De_ESCorr;
end
activity implementation DetAtt3 . DetAtt3_I
  operations
    "红外姿态确定：根据公式表B3条目,利用红外数据进行有效性判断及处理和姿态修正"
end
activity CalCtrl1
  features
    input data port WorkMode;
    input data port FS_ModeProc;
    input data port Atti_AAM;
    input data port dAtti_AAM;
    input data port w_AAM;
    input data port FS_AttD;
    input data port q_STDyn;
    input data port w_STDyn;
    input data port Phi_ES;
    input data port theta_ES;
    input data port Atti_Ref;
    input data port Seq_AttD;
    input data port dAtti_ESG;
    input data port wbo_ESG;
    input data port woi;
    input data port FP_BMC;
    input data port qri;
    input data port wri;
    input data port coi;
    input data port w_ESG;
